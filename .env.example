# ============================================================
# Aethel Multi-Vendor E-Commerce — Root Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# Docker Compose reads from .env automatically.

# ── MongoDB Atlas ──────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aethel?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_64_char_random_string
JWT_EXPIRES_IN=7d

# ── Inter-Service Secret (Core ↔ Payment) ─────────────────
SERVICE_SECRET=change_me_to_another_64_char_random_string

# ── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# ── Service URLs (Docker internal DNS) ─────────────────────
PAYMENT_SERVICE_URL=http://payment-api:5001
CORE_SERVICE_URL=http://core-api:5000

# ── Ports ──────────────────────────────────────────────────
CORE_API_PORT=5000
PAYMENT_API_PORT=5001
FRONTEND_PORT=80

# ── Node Environment ──────────────────────────────────────
NODE_ENV=development
